page {
  background: #f7f7fa;
  color: #2b2430;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
}

view, text, input, textarea, button, picker {
  box-sizing: border-box;
}

/* 全局字体优化 */
text {
  font-smooth: antialiased;
  -webkit-font-smoothing: antialiased;
}

/* 去除按钮默认阴影 */
button::after {
  border: 0 !important;
}

/* 统一主题色变量（医伴心途 · 粉色渐变）*/
page {
  --color-primary: #ff4d8d;
  --color-primary-light: #ff9ec4;
  --color-primary-soft: #fff0f6;
  --color-primary-bg: #ffd9e8;
  --color-text: #2b2430;
  --color-text-sub: #8f8699;
  --color-text-mute: #b7b0c2;
  --color-border: #f1eaf5;
  --color-bg: #f7f7fa;
}
