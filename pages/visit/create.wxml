<scroll-view class="scrollarea" scroll-y>
  <view class="page">
    <view class="hero">
      <text class="h-title">立即下单</text>
      <text class="h-sub">填写预约信息，提交后等待陪诊师接单</text>
    </view>

    <view class="location-strip">
      <text class="location-label">服务位置</text>
      <text class="location-address">{{currentAddress || '正在获取定位，可手动填写地址'}}</text>
      <button class="location-button" loading="{{locating}}" disabled="{{locating}}" bindtap="refreshLocation">定位</button>
    </view>

    <view class="card">
      <picker mode="selector" range="{{hospitals}}" range-key="name" value="{{selectedHospitalIndex}}" bindchange="onHospitalChange">
        <view class="row">
          <text class="k">就诊医院</text>
          <text wx:if="{{hospitals.length}}" class="v picker-value">{{hospitals[selectedHospitalIndex].name}} ›</text>
          <text wx:elif="{{hospitalLoading}}" class="v muted">加载中</text>
          <text wx:else class="v muted">请选择医院 ›</text>
        </view>
      </picker>
      <view wx:if="{{hospitals.length}}" class="selection-hint">{{hospitals[selectedHospitalIndex].address}}</view>

      <picker mode="selector" range="{{services}}" range-key="name" value="{{selectedServiceIndex}}" bindchange="onServiceChange">
        <view class="row">
          <text class="k">服务项目</text>
          <text wx:if="{{services.length}}" class="v picker-value">{{services[selectedServiceIndex].name}} ›</text>
          <text wx:else class="v muted">请选择服务项目 ›</text>
        </view>
      </picker>
      <view wx:if="{{services.length}}" class="selection-hint">{{services[selectedServiceIndex].description}}</view>

      <picker mode="selector" range="{{serviceTypes}}" value="{{selectedServiceTypeIndex}}" bindchange="onServiceTypeChange">
        <view class="row">
          <text class="k">服务类型</text>
          <text class="v picker-value">{{serviceTypes[selectedServiceTypeIndex]}} ›</text>
        </view>
      </picker>

      <view class="row">
        <text class="k">预约日期</text>
        <picker mode="date" value="{{form.appointmentDate}}" start="{{form.appointmentDate}}" data-field="appointmentDate" bindchange="onFieldInput"><text class="v picker-value">{{form.appointmentDate}} ›</text></picker>
      </view>
      <view class="row">
        <text class="k">预约时间</text>
        <picker mode="time" value="{{form.appointmentTime}}" data-field="appointmentTime" bindchange="onFieldInput"><text class="v picker-value">{{form.appointmentTime}} ›</text></picker>
      </view>
      <view class="row">
        <text class="k">患者姓名</text>
        <input class="v-input" value="{{form.patientName}}" data-field="patientName" bindinput="onFieldInput" placeholder="请输入姓名" />
      </view>
      <view class="row">
        <text class="k">联系电话</text>
        <input class="v-input" value="{{form.patientPhone}}" data-field="patientPhone" bindinput="onFieldInput" type="number" placeholder="请输入手机号" />
      </view>
      <view class="row address-row">
        <text class="k">服务地址</text>
        <input class="v-input" value="{{form.addressDetail}}" data-field="addressDetail" bindinput="onFieldInput" placeholder="定位后可补充楼栋、病区" />
      </view>
    </view>

    <view class="card note-card">
      <text class="c-title">服务备注</text>
      <textarea class="textarea" value="{{form.note}}" data-field="note" bindinput="onFieldInput" maxlength="500" placeholder="护理需求、行动情况、科室等" />
    </view>

    <view class="tip">提交后陪诊师会主动与您联系</view>
    <button class="submit-button" loading="{{submitting}}" disabled="{{submitting}}" bindtap="submit">提交预约</button>
  </view>
</scroll-view>
