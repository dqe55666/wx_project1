<view class="page">
  <view class="hero">
    <view class="avatar">👩‍⚕️</view>
    <text class="h-title">{{name}}</text>
    <text class="h-sub">{{level}}  ·  ⭐ {{score}}  ·  服务 {{orders}} 次</text>
  </view>

  <view class="card">
    <text class="c-title">个人简介</text>
    <text class="c-desc">{{intro}}</text>
  </view>

  <view class="card">
    <text class="c-title">擅长医院</text>
    <view class="tags" style="margin-top:16rpx;">
      <text wx:for="{{hospitals}}" wx:key="*this" class="tag">{{item}}</text>
      <text wx:if="{{hospitals.length === 0}}" class="c-desc">接单后显示服务医院</text>
    </view>
  </view>

  <view class="card">
    <text class="c-title">用户评价</text>
    <text class="c-desc">评价数据来自服务完成后的客户评价，当前暂无可展示内容。</text>
  </view>
</view>
