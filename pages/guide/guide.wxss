.page {
  height: 100vh;
  background: linear-gradient(180deg, #fff5f8 0%, #fce4ec 100%);
  position: relative;
  box-sizing: border-box;
  padding: 0 0 calc(80rpx + env(safe-area-inset-bottom));
}

.skip {
  position: absolute;
  right: 32rpx;
  top: 80rpx;
  z-index: 10;
  color: #bd548f;
  font-size: 26rpx;
  padding: 8rpx 20rpx;
  background: rgba(255, 255, 255, 0.6);
  border-radius: 24rpx;
}

.swiper {
  height: 100%;
}

.slide {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100%;
  padding: 0 60rpx;
}

.illu {
  width: 360rpx;
  height: 360rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 180rpx;
  margin-bottom: 60rpx;
  box-shadow: 0 12rpx 40rpx rgba(233, 30, 99, 0.2);
}

.illu-1 { background: linear-gradient(135deg, #ff8a80, #e91e63); }
.illu-2 { background: linear-gradient(135deg, #ffd54f, #ff8a00); }
.illu-3 { background: linear-gradient(135deg, #80deea, #26c6da); }

.title {
  color: #2d1b2e;
  font-size: 48rpx;
  font-weight: 700;
  margin-bottom: 16rpx;
}

.desc {
  color: #bd548f;
  font-size: 28rpx;
  text-align: center;
  line-height: 1.6;
}

.enter-btn {
  margin-top: 60rpx;
  padding: 24rpx 80rpx;
  background: linear-gradient(135deg, #e91e63, #ff5a8a);
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 48rpx;
  box-shadow: 0 6rpx 20rpx rgba(233, 30, 99, 0.4);
}

.dots {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 80rpx;
  display: flex;
  justify-content: center;
  gap: 12rpx;
}

.dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #f8bbd0;
}

.dot.active {
  background: #e91e63;
  width: 32rpx;
  border-radius: 8rpx;
}
