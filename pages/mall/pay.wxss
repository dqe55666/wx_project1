@import "/assets/common.wxss";

.amount {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 60rpx 0;
  margin-bottom: 20rpx;
  text-align: center;
}

.amt-label {
  display: block;
  color: #999;
  font-size: 26rpx;
  margin-bottom: 16rpx;
}

.amt-value {
  display: block;
  color: #ff4d8d;
  font-size: 64rpx;
  font-weight: 700;
}

.pay-type {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.pay-type:last-child { border-bottom: 0; }

.pay-type.active .pt-name { color: #ff4d8d; font-weight: 600; }
.disabled { background: #cbd5e1 !important; color: #64748b !important; }

.pt-icon { font-size: 36rpx; }

.pt-name {
  flex: 1;
  color: #2b2430;
  font-size: 28rpx;
}

.radio {
  width: 36rpx;
  height: 36rpx;
  border: 2rpx solid #ccc;
  border-radius: 50%;
  position: relative;
}

.radio.checked {
  border-color: #ff4d8d;
}

.radio.checked::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 20rpx;
  height: 20rpx;
  background: #ff4d8d;
  border-radius: 50%;
}
