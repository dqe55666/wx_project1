page { 
  height: 100vh; 
  background: #f7f7fa; 
}

.scrollarea { 
  height: 100vh; 
}

.page { 
  min-height: 100vh; 
  padding: 32rpx 28rpx calc(40rpx + env(safe-area-inset-bottom)); 
  box-sizing: border-box; 
}

.heading { 
  margin-bottom: 24rpx; 
}

.title { 
  color: #ff4d8d; 
  display: block; 
  font-size: 44rpx; 
  font-weight: 700; 
  line-height: 1.25; 
}

.subtitle { 
  color: #8f8699; 
  display: block; 
  font-size: 26rpx; 
  line-height: 1.5; 
  margin-top: 10rpx; 
}

.order-card { 
  background: #fff; 
  border: 1rpx solid #ffb8d5; 
  border-radius: 8rpx; 
  margin-bottom: 18rpx; 
  padding: 22rpx 24rpx; 
}

.order-top { 
  align-items: center; 
  display: flex; 
  justify-content: space-between; 
}

.order-no { 
  color: #8f8699; 
  font-size: 23rpx; 
}

.status { 
  border-radius: 4rpx; 
  font-size: 22rpx; 
  padding: 5rpx 10rpx; 
}

.status.pending { 
  background: #fff0f6; 
  color: #ff4d8d; 
}
.status.accepted { 
  background: #f1eaf5; 
  color: #ff4d8d; 
}
.status.in_progress { 
  background: #f3e5f5; 
  color: #8e24aa; 
}
.status.completed { 
  background: #f3e5f5; 
  color: #7b1fa2; 
}
.status.stopped { 
  background: #ffebee; 
  color: #c62828; 
}

.service-name { 
  color: #b03070; 
  font-size: 32rpx; 
  font-weight: 600; 
  margin: 16rpx 0 12rpx; 
}

.detail { 
  color: #ad1457; 
  font-size: 25rpx; 
  line-height: 1.55; 
}

.review-btn, .submit-review-btn { 
  background: linear-gradient(135deg, #ff4d8d, #f1eaf5); 
  border-radius: 6rpx; 
  color: #fff; 
  font-size: 26rpx; 
  height: 66rpx; 
  line-height: 66rpx; 
  margin: 18rpx 0 0; 
  padding: 0 24rpx; 
}

.tracking-btn {
  background: #e0f2f1;
  border: 1rpx solid #4db6ac;
  border-radius: 6rpx;
  color: #00796b;
  font-size: 26rpx;
  height: 66rpx;
  line-height: 66rpx;
  margin: 18rpx 0 0;
  padding: 0 24rpx;
}

.tracking-btn::after {
  border: 0;
}

.review-btn::after, .submit-review-btn::after, .cancel-btn::after, .star::after { 
  border: 0; 
}

.review-result { 
  background: #fff0f6; 
  color: #e0447e; 
  font-size: 25rpx; 
  line-height: 1.5; 
  margin-top: 18rpx; 
  padding: 16rpx; 
}

.review-score { 
  color: #ff4d8d; 
  display: block; 
  font-weight: 600; 
  margin-bottom: 6rpx; 
}

.review-form { 
  border-top: 1rpx solid #f1eaf5; 
  margin-top: 18rpx; 
  padding-top: 18rpx; 
}

.form-label { 
  color: #8f8699; 
  display: block; 
  font-size: 24rpx; 
  margin-bottom: 10rpx; 
}

.stars { 
  display: flex; 
  gap: 8rpx; 
  margin-bottom: 16rpx; 
}

.star { 
  background: transparent; 
  color: #ffb8d5; 
  font-size: 46rpx; 
  height: 60rpx; 
  line-height: 60rpx; 
  margin: 0; 
  padding: 0 6rpx; 
}

.star.selected { 
  color: #ff4d8d; 
}

textarea { 
  background: #fff8fa; 
  border: 1rpx solid #f1eaf5; 
  box-sizing: border-box; 
  color: #b03070; 
  font-size: 27rpx; 
  height: 150rpx; 
  padding: 14rpx; 
  width: 100%; 
}

.review-actions { 
  display: flex; 
  gap: 14rpx; 
  justify-content: flex-end; 
  margin-top: 16rpx; 
}

.cancel-btn { 
  background: #f1eaf5; 
  border-radius: 6rpx; 
  color: #ff4d8d; 
  font-size: 26rpx; 
  height: 66rpx; 
  line-height: 66rpx; 
  margin: 0; 
}

.submit-review-btn { 
  margin: 0; 
}

.empty { 
  color: #8f8699; 
  font-size: 27rpx; 
  padding: 80rpx 0; 
  text-align: center; 
}
