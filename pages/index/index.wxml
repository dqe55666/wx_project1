<scroll-view class="scrollarea" scroll-y>
  <view class="page">
    <view class="hero">
      <text class="eyebrow">护理陪护服务</text>
      <text class="title">主页</text>
      <text class="subtitle">预约、记录、知识与心情漂瓶，都从这里开始。</text>
    </view>

    <view class="entry-grid">
      <view wx:for="{{entries}}" wx:key="title" class="entry-card {{item.tone}}" data-url="{{item.url}}" bindtap="openEntry" hover-class="entry-card-active">
        <view class="entry-mark">{{index + 1}}</view>
        <view class="entry-content">
          <text class="entry-title">{{item.title}}</text>
          <text class="entry-desc">{{item.desc}}</text>
        </view>
        <text class="entry-arrow">›</text>
      </view>
    </view>
  </view>
</scroll-view>
