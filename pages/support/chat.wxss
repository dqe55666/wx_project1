page { height: 100vh; background: #f5f5f7; }
.page { display: flex; flex-direction: column; height: 100vh; }
.notice { background: #ffffff; border-bottom: 1rpx solid #f0dce5; padding: 22rpx 28rpx; }
.notice-title { color: #2d1b2e; display: block; font-size: 30rpx; font-weight: 700; }
.notice-text { color: #9a7180; display: block; font-size: 24rpx; margin-top: 8rpx; }
.message-list { box-sizing: border-box; flex: 1; padding: 24rpx; }
.state { color: #9a7180; font-size: 26rpx; padding: 90rpx 20rpx; text-align: center; }
.message { display: flex; flex-direction: column; margin-bottom: 24rpx; }
.message.me { align-items: flex-end; }
.message.other { align-items: flex-start; }
.bubble { border-radius: 8rpx; font-size: 28rpx; line-height: 1.55; max-width: 74%; overflow-wrap: anywhere; padding: 18rpx 22rpx; }
.me .bubble { background: #e91e63; color: #ffffff; }
.other .bubble { background: #ffffff; color: #2d1b2e; }
.time { color: #a78a95; font-size: 20rpx; margin-top: 7rpx; }
.composer { align-items: center; background: #ffffff; border-top: 1rpx solid #f0dce5; display: flex; gap: 16rpx; padding: 16rpx 20rpx calc(16rpx + env(safe-area-inset-bottom)); }
.input { background: #f7f0f3; border-radius: 6rpx; color: #2d1b2e; flex: 1; font-size: 28rpx; height: 68rpx; padding: 0 20rpx; }
.send { background: #e91e63; border-radius: 6rpx; color: #ffffff; font-size: 27rpx; height: 68rpx; line-height: 68rpx; margin: 0; padding: 0 24rpx; }
.send::after { border: 0; }
