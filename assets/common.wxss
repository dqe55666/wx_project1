/* 公共页面样式 - 子页面 wxss @import "/assets/common.wxss" 即可 */
/* 主题：医伴心途 · 粉色渐变（与首页统一） */

.page {
  min-height: 100vh;
  background: #f7f7fa;
  padding: 24rpx 28rpx calc(40rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.page.grey { background: #f7f7fa; }

/* 顶部 hero */
.hero {
  background: linear-gradient(160deg, #ff5f9e 0%, #ff4d8d 60%, #ff74ab 100%);
  border-radius: 28rpx;
  padding: 44rpx 36rpx;
  color: #ffffff;
  margin-bottom: 28rpx;
  box-shadow: 0 12rpx 28rpx rgba(255, 77, 141, 0.26);
}

.hero.orange { background: linear-gradient(150deg, #ffb74d, #ff8f5a); }
.hero.blue { background: linear-gradient(150deg, #64b5f6, #2196f3); }
.hero.green { background: linear-gradient(150deg, #9ee06a, #4caf50); }
.hero.purple { background: linear-gradient(150deg, #c9a8ff, #8e6bf0); }

.h-title {
  display: block;
  font-size: 42rpx;
  font-weight: 800;
  margin-bottom: 10rpx;
}

.h-sub {
  display: block;
  font-size: 26rpx;
  opacity: 0.9;
}

/* 卡片 */
.card {
  background: #ffffff;
  border: 2rpx solid #f1eaf5;
  border-radius: 26rpx;
  padding: 28rpx 30rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 6rpx 18rpx rgba(255, 77, 141, 0.06);
}

.card.tight { padding: 0 30rpx; }

.c-title {
  display: block;
  color: #2b2430;
  font-size: 32rpx;
  font-weight: 700;
  margin-bottom: 14rpx;
}

.c-desc {
  display: block;
  color: #a49db0;
  font-size: 26rpx;
  line-height: 1.6;
}

/* 行 */
.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 26rpx 0;
  border-bottom: 1rpx solid #f4f0f7;
}

.row:last-child { border-bottom: 0; }

.k { color: #8f8699; font-size: 28rpx; }
.v { color: #2b2430; font-size: 28rpx; }
.v-input {
  flex: 1;
  text-align: right;
  color: #2b2430;
  font-size: 28rpx;
  min-height: 44rpx;
}

.v-input[disabled] { color: #b7b0c2; }

/* 提示 */
.tip {
  text-align: center;
  color: #a49db0;
  font-size: 24rpx;
  margin: 20rpx 0 0;
}

/* 主操作 */
.action {
  background: linear-gradient(135deg, #ff5f9e, #ff4d8d);
  color: #ffffff;
  border-radius: 22rpx;
  font-size: 32rpx;
  font-weight: 700;
  height: 96rpx;
  line-height: 96rpx;
  text-align: center;
  margin-top: 36rpx;
  box-shadow: 0 12rpx 26rpx rgba(255, 77, 141, 0.3);
  transition: transform 0.16s ease, opacity 0.16s ease;
}

.action:active { transform: scale(0.98); opacity: 0.95; }
.action::after { border: 0; }

.action.secondary {
  background: #ffffff;
  color: #ff4d8d;
  border: 2rpx solid #ffc2da;
  box-shadow: none;
}

.action-row {
  display: flex;
  gap: 18rpx;
  margin-top: 36rpx;
}

.action-row .action { flex: 1; margin-top: 0; }

/* 标签 */
.tags { display: flex; flex-wrap: wrap; gap: 14rpx; }

.tag {
  background: #fff0f6;
  color: #ff4d8d;
  font-size: 24rpx;
  padding: 9rpx 22rpx;
  border-radius: 24rpx;
}

.tag.solid {
  background: linear-gradient(135deg, #ff5f9e, #ff4d8d);
  color: #ffffff;
}

.tag.outline {
  background: #ffffff;
  border: 2rpx solid #ffc2da;
}

/* 列表 */
.list-item {
  display: flex;
  align-items: center;
  gap: 22rpx;
  padding: 26rpx 0;
  border-bottom: 1rpx solid #f4f0f7;
}

.list-item:last-child { border-bottom: 0; }

.list-item .li-avatar {
  width: 92rpx;
  height: 92rpx;
  border-radius: 26rpx;
  background: linear-gradient(145deg, #fff0f6, #ffd9e8);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  flex-shrink: 0;
}

.list-item .li-main { flex: 1; min-width: 0; }

.li-title { color: #2b2430; font-size: 29rpx; font-weight: 700; }
.li-sub { color: #a49db0; font-size: 24rpx; margin-top: 6rpx; }
.li-arrow { color: #c5becf; font-size: 32rpx; }

/* 空状态 */
.empty {
  text-align: center;
  color: #b7b0c2;
  font-size: 26rpx;
  padding: 90rpx 0;
}

/* 评分 */
.stars {
  display: flex;
  gap: 14rpx;
  margin: 14rpx 0;
}

.star {
  font-size: 50rpx;
  color: #ddd;
  background: transparent;
  padding: 0;
  line-height: 1;
}

.star::after { border: 0; }

.star.active { color: #ffb300; }

/* 输入域 */
.textarea {
  width: 100%;
  min-height: 200rpx;
  background: #faf7fb;
  border: 2rpx solid #f1eaf5;
  border-radius: 18rpx;
  padding: 22rpx;
  color: #2b2430;
  font-size: 28rpx;
  box-sizing: border-box;
  margin-top: 16rpx;
}
