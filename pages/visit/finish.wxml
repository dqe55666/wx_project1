<view class="page">
  <view class="hero green">
    <text class="h-title">结束陪诊</text>
    <text class="h-sub">服务完成后请填写结束说明</text>
  </view>

  <view class="card">
    <text class="c-title">陪诊小结</text>
    <textarea class="textarea" placeholder="请填写本次陪诊的完成情况、患者反馈等" value="{{reason}}" bindinput="onReason"></textarea>
  </view>

  <view class="card">
    <text class="c-title">本次服务清单</text>
    <view class="row"><text class="k">挂号</text><text class="v">2 次</text></view>
    <view class="row"><text class="k">取药</text><text class="v">1 次</text></view>
    <view class="row"><text class="k">问诊陪同</text><text class="v">45 分钟</text></view>
  </view>

  <view class="action" bindtap="confirm">确认结束陪诊</view>
</view>
