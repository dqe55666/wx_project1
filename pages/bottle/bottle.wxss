page {
  height: 100vh;
  background: #f1f9fc;
}

.scrollarea {
  height: 100vh;
}

.page {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 34rpx 28rpx calc(44rpx + env(safe-area-inset-bottom));
}

.heading {
  margin-bottom: 24rpx;
}

.title {
  color: #1d3b4f;
  display: block;
  font-size: 46rpx;
  font-weight: 700;
  line-height: 1.25;
}

.subtitle {
  color: #527386;
  display: block;
  font-size: 26rpx;
  line-height: 1.5;
  margin-top: 10rpx;
}

.bottle-panel,
.write-panel {
  background: #ffffff;
  border: 1rpx solid #cfe5ee;
  border-radius: 8rpx;
  margin-bottom: 18rpx;
  padding: 26rpx;
}

.panel-label {
  color: #039be5;
  display: block;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1.4;
  margin-bottom: 12rpx;
}

.bottle-text {
  color: #1d3b4f;
  display: block;
  font-size: 30rpx;
  line-height: 1.65;
  margin-bottom: 22rpx;
}

textarea {
  background: #f7fcff;
  border: 1rpx solid #cfe5ee;
  border-radius: 8rpx;
  box-sizing: border-box;
  color: #1d3b4f;
  font-size: 27rpx;
  height: 180rpx;
  line-height: 1.5;
  padding: 18rpx;
  width: 100%;
}

.primary-btn,
.secondary-btn {
  border-radius: 8rpx;
  font-size: 28rpx;
  height: 76rpx;
  line-height: 76rpx;
  margin-top: 20rpx;
}

.primary-btn {
  background: #039be5;
  color: #ffffff;
}

.secondary-btn {
  background: #e1f5fe;
  color: #0277bd;
}

.primary-btn::after,
.secondary-btn::after {
  border: 0;
}
