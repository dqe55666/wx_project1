.page {
  min-height: 100vh;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
  background: #f5f5f7;
  box-sizing: border-box;
}

/* 快捷入口 */
.quick-actions {
  background: #ffffff;
  display: flex;
  justify-content: space-between;
  padding: 28rpx 16rpx;
}

.qa-item {
  align-items: center;
  display: flex;
  flex: 1;
  flex-direction: column;
  gap: 12rpx;
}

.qa-icon {
  align-items: center;
  border-radius: 24rpx;
  display: flex;
  font-size: 36rpx;
  height: 96rpx;
  justify-content: center;
  width: 96rpx;
}

.qa-name {
  color: #2d1b2e;
  font-size: 24rpx;
  font-weight: 500;
}

.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 32rpx 12rpx;
  background: #ffffff;
}

.city {
  color: #2d1b2e;
  font-size: 32rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  gap: 4rpx;
}

.caret { color: #2d1b2e; font-size: 24rpx; }

.search-icon {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  position: relative;
}

.search-icon::after {
  content: '⚡';
  position: absolute;
  right: -8rpx;
  bottom: -4rpx;
  font-size: 20rpx;
  color: #fbc02d;
}

/* tabs */
.tabs {
  display: flex;
  background: #ffffff;
  border-bottom: 1rpx solid #f0f0f0;
  position: sticky;
  top: 0;
  z-index: 5;
}

.tab {
  flex: 1;
  text-align: center;
  position: relative;
  padding: 24rpx 0;
  color: #888;
  font-size: 28rpx;
}

.tab.active {
  color: #2d1b2e;
  font-weight: 700;
}

.tab-bar {
  position: absolute;
  left: 50%;
  bottom: 8rpx;
  transform: translateX(-50%);
  width: 48rpx;
  height: 6rpx;
  background: #e91e63;
  border-radius: 4rpx;
}

/* 卡片列表 */
.card-list {
  padding: 20rpx 24rpx 0;
}

.card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 28rpx 28rpx 0;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 20rpx;
  border-bottom: 1rpx dashed #eee;
}

.order-no {
  color: #2d1b2e;
  font-size: 26rpx;
  font-weight: 600;
}

.tag {
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  gap: 4rpx;
}

.tag-vip {
  background: linear-gradient(135deg, #ffd54f, #ffb300);
  color: #ffffff;
}

.tag-normal {
  background: #f0f0f0;
  color: #888;
}

.bolt {
  font-size: 18rpx;
  color: #fbc02d;
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.row.no-border { border-bottom: 0; }

.row-key { color: #999; font-size: 26rpx; }
.row-val { color: #2d1b2e; font-size: 26rpx; }
.row-val.bold { font-weight: 600; }

/* 底部操作 */
.card-foot {
  display: flex;
  gap: 16rpx;
  padding: 24rpx 0 28rpx;
  margin: 0 -28rpx;
  padding-left: 28rpx;
  padding-right: 28rpx;
  border-top: 1rpx dashed #eee;
}

.btn {
  flex: 1;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  border-radius: 36rpx;
  font-size: 28rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
}

.btn.ghost {
  border: 2rpx solid #e91e63;
  color: #e91e63;
  background: #ffffff;
}

.btn.solid {
  background: linear-gradient(135deg, #ff5a8a, #e91e63);
  color: #ffffff;
  box-shadow: 0 4rpx 12rpx rgba(233, 30, 99, 0.3);
}

.btn.full {
  background: linear-gradient(135deg, #ff5a8a, #e91e63);
  color: #ffffff;
  box-shadow: 0 4rpx 12rpx rgba(233, 30, 99, 0.3);
}

.empty {
  text-align: center;
  color: #999;
  padding: 80rpx 0;
  font-size: 26rpx;
}
