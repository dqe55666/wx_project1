page { background: #f5f5f7; min-height: 100vh; }
.page { box-sizing: border-box; min-height: 100vh; padding: 32rpx 28rpx calc(44rpx + env(safe-area-inset-bottom)); }
.intro { margin: 4rpx 4rpx 28rpx; }
.title { color: #2d1b2e; display: block; font-size: 42rpx; font-weight: 700; }
.subtitle { color: #987080; display: block; font-size: 25rpx; line-height: 1.5; margin-top: 10rpx; }
.form { background: #ffffff; border: 1rpx solid #f0dce5; border-radius: 8rpx; padding: 24rpx; }
.label { color: #6e4d59; display: block; font-size: 25rpx; margin: 0 0 12rpx; }
input, textarea { background: #fff9fb; border: 1rpx solid #f0dce5; border-radius: 6rpx; box-sizing: border-box; color: #2d1b2e; font-size: 28rpx; margin-bottom: 24rpx; padding: 16rpx; width: 100%; }
input { height: 78rpx; }
textarea { height: 280rpx; line-height: 1.55; }
.submit { background: #e91e63; border-radius: 6rpx; color: #ffffff; font-size: 29rpx; height: 82rpx; line-height: 82rpx; margin-top: 26rpx; }
.submit::after { border: 0; }
