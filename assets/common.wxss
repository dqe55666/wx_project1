/* 公共页面样式 - 子页面 wxss @import "/assets/common.wxss" 即可 */

.page {
  min-height: 100vh;
  background: #fff5f8;
  padding: 24rpx 28rpx calc(40rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.page.grey { background: #f5f5f7; }

/* 顶部 hero */
.hero {
  background: linear-gradient(135deg, #e91e63, #ff5a8a);
  border-radius: 24rpx;
  padding: 40rpx 32rpx;
  color: #ffffff;
  margin-bottom: 24rpx;
  box-shadow: 0 6rpx 20rpx rgba(233, 30, 99, 0.25);
}

.hero.orange { background: linear-gradient(135deg, #ff8a00, #ff5a8a); }
.hero.blue { background: linear-gradient(135deg, #26c6da, #00bcd4); }
.hero.green { background: linear-gradient(135deg, #66bb6a, #43a047); }
.hero.purple { background: linear-gradient(135deg, #9575cd, #7e57c2); }

.h-title {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
}

.h-sub {
  display: block;
  font-size: 26rpx;
  opacity: 0.9;
}

/* 卡片 */
.card {
  background: #ffffff;
  border: 2rpx solid #f8bbd0;
  border-radius: 20rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(233, 30, 99, 0.04);
}

.card.tight { padding: 0 28rpx; }

.c-title {
  display: block;
  color: #e91e63;
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.c-desc {
  display: block;
  color: #bd548f;
  font-size: 26rpx;
  line-height: 1.6;
}

/* 行 */
.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.row:last-child { border-bottom: 0; }

.k { color: #bd548f; font-size: 28rpx; }
.v { color: #2d1b2e; font-size: 28rpx; }
.v-input {
  flex: 1;
  text-align: right;
  color: #2d1b2e;
  font-size: 28rpx;
  min-height: 44rpx;
}

.v-input[disabled] { color: #999; }

/* 提示 */
.tip {
  text-align: center;
  color: #bd548f;
  font-size: 24rpx;
  margin: 16rpx 0 0;
}

/* 主操作 */
.action {
  background: linear-gradient(135deg, #e91e63, #ff5a8a);
  color: #ffffff;
  border-radius: 16rpx;
  font-size: 30rpx;
  font-weight: 600;
  height: 92rpx;
  line-height: 92rpx;
  text-align: center;
  margin-top: 32rpx;
  box-shadow: 0 6rpx 20rpx rgba(233, 30, 99, 0.3);
}

.action::after { border: 0; }

.action.secondary {
  background: #ffffff;
  color: #e91e63;
  border: 2rpx solid #e91e63;
  box-shadow: none;
}

.action-row {
  display: flex;
  gap: 16rpx;
  margin-top: 32rpx;
}

.action-row .action { flex: 1; margin-top: 0; }

/* 标签 */
.tags { display: flex; flex-wrap: wrap; gap: 12rpx; }

.tag {
  background: #fce4ec;
  color: #e91e63;
  font-size: 24rpx;
  padding: 8rpx 20rpx;
  border-radius: 24rpx;
}

.tag.solid {
  background: linear-gradient(135deg, #e91e63, #ff5a8a);
  color: #ffffff;
}

.tag.outline {
  background: #ffffff;
  border: 2rpx solid #e91e63;
}

/* 列表 */
.list-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.list-item:last-child { border-bottom: 0; }

.list-item .li-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: #fce4ec;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  flex-shrink: 0;
}

.list-item .li-main { flex: 1; min-width: 0; }

.li-title { color: #2d1b2e; font-size: 28rpx; font-weight: 600; }
.li-sub { color: #bd548f; font-size: 24rpx; margin-top: 6rpx; }
.li-arrow { color: #ccc; font-size: 32rpx; }

/* 空状态 */
.empty {
  text-align: center;
  color: #bd548f;
  font-size: 26rpx;
  padding: 80rpx 0;
}

/* 评分 */
.stars {
  display: flex;
  gap: 12rpx;
  margin: 12rpx 0;
}

.star {
  font-size: 48rpx;
  color: #ddd;
  background: transparent;
  padding: 0;
  line-height: 1;
}

.star::after { border: 0; }

.star.active { color: #ffb300; }

/* 输入域 */
.textarea {
  width: 100%;
  min-height: 200rpx;
  background: #fff8fa;
  border: 2rpx solid #f8bbd0;
  border-radius: 12rpx;
  padding: 20rpx;
  color: #2d1b2e;
  font-size: 28rpx;
  box-sizing: border-box;
  margin-top: 16rpx;
}
