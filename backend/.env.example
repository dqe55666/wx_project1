# Docker 使用 Linux 宿主机网络，因此这里继续使用服务器本地 MySQL 配置。
# 数据库不存在时，后端会用 root 自动创建 care_booking。
DATABASE_URL=mysql+pymysql://root:replace-with-your-root-password@127.0.0.1:3306/care_booking?charset=utf8mb4
AUTO_CREATE_DATABASE=true
# Docker 构建加速：前者是 Docker Hub 的国内代理，后者是 Python 依赖镜像。
PYTHON_IMAGE=docker.m.daocloud.io/library/python:3.13-slim
PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
CORS_ORIGINS=*
AMAP_KEY=your_amap_web_service_key
AMAP_PRIVATE_KEY=your_amap_web_service_private_key
STAFF_TOKEN_SECRET=replace-with-a-random-production-secret
STAFF_TOKEN_EXPIRE_SECONDS=28800
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-admin-password
ADMIN_TOKEN_SECRET=replace-with-another-random-production-secret
ADMIN_TOKEN_EXPIRE_SECONDS=28800
