.page {
  min-height: 100vh;
  padding: 60rpx 48rpx calc(40rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: #fff5f8;
}

/* Logo 区 */
.logo-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 60rpx;
}

.logo {
  width: 120rpx;
  height: 120rpx;
  background: linear-gradient(135deg, #e91e63, #f06292);
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(233, 30, 99, 0.3);
  margin-bottom: 20rpx;
}

.logo-icon {
  color: #ffffff;
  font-size: 64rpx;
  font-weight: 700;
  line-height: 1;
}

.page-title {
  color: #2d1b2e;
  font-size: 40rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
}

/* 表单 */
.form {
  margin-bottom: 8rpx;
}

.input-box {
  display: flex;
  align-items: center;
  background: #ffffff;
  border: 2rpx solid #f8bbd0;
  border-radius: 16rpx;
  padding: 0 24rpx;
  height: 96rpx;
  margin-bottom: 28rpx;
  box-shadow: 0 2rpx 8rpx rgba(233, 30, 99, 0.04);
  transition: border-color 0.2s ease;
}

.input-box:focus-within {
  border-color: #e91e63;
}

.input-icon {
  font-size: 32rpx;
  margin-right: 16rpx;
  opacity: 0.7;
}

.input {
  flex: 1;
  color: #2d1b2e;
  font-size: 30rpx;
  height: 96rpx;
  line-height: 96rpx;
}

.ph {
  color: #c9a8b5;
  font-size: 30rpx;
}

.eye {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  opacity: 0.6;
}

/* 链接行 */
.link-row {
  display: flex;
  justify-content: space-between;
  margin: 12rpx 0 32rpx;
}

.link {
  color: #e91e63;
  font-size: 26rpx;
  position: relative;
  padding-right: 24rpx;
}

.link::after {
  content: '⚡';
  position: absolute;
  right: 0;
  top: 50%;
  transform: translateY(-50%);
  font-size: 22rpx;
  color: #fbc02d;
}

/* 主按钮 */
.primary-btn {
  background: linear-gradient(135deg, #e91e63, #f48fb1);
  border: none;
  border-radius: 16rpx;
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 600;
  height: 96rpx;
  line-height: 96rpx;
  box-shadow: 0 6rpx 20rpx rgba(233, 30, 99, 0.35);
  margin: 0;
}

.primary-btn::after {
  border: 0;
}

.primary-btn[disabled] {
  opacity: 0.6;
}

/* 人机验证 */
.captcha-wrap {
  margin-top: 36rpx;
}

/* 协议 */
.agreement {
  position: fixed;
  left: 0;
  right: 0;
  bottom: calc(40rpx + env(safe-area-inset-bottom));
  padding: 0 48rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  box-sizing: border-box;
}

.checkbox {
  width: 32rpx;
  height: 32rpx;
  border: 2rpx solid #bd548f;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  font-size: 22rpx;
  background: #ffffff;
  flex-shrink: 0;
}

.checkbox.checked {
  background: #e91e63;
  border-color: #e91e63;
}

.agreement-text {
  color: #bd548f;
  font-size: 24rpx;
  line-height: 1.4;
}

.link-inline {
  color: #e91e63;
}
