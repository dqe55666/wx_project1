page {
  background: #fff5f8;
  color: #2d1b2e;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
}

view, text, input, textarea, button, picker {
  box-sizing: border-box;
}

/* 全局字体优化 */
text {
  font-smooth: antialiased;
  -webkit-font-smoothing: antialiased;
}

/* 去除按钮默认阴影 */
button::after {
  border: 0 !important;
}