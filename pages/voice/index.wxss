.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 88rpx 48rpx;
  background: linear-gradient(180deg, #fff5f8 0%, #ffffff 55%);
  text-align: center;
}

.hero { display: flex; flex-direction: column; align-items: center; }
.icon {
  width: 152rpx;
  height: 152rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #ffe4ec, #f8bbd0);
  font-size: 72rpx;
}
.title { margin-top: 32rpx; color: #2d1b2e; font-size: 42rpx; font-weight: 700; }
.subtitle { margin-top: 14rpx; color: #9b6e87; font-size: 26rpx; }
.record-button {
  width: 360rpx;
  height: 360rpx;
  margin: 88rpx auto 28rpx;
  border-radius: 50%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
  background: linear-gradient(135deg, #f48fb1, #e91e63);
  color: #ffffff;
  font-size: 30rpx;
  box-shadow: 0 18rpx 40rpx rgba(233, 30, 99, .22);
}
.record-button.recording { background: linear-gradient(135deg, #ef5350, #c62828); }
.record-button::after { border: 0; }
.record-icon { font-size: 66rpx; line-height: 1; }
.status { color: #9b6e87; font-size: 26rpx; }
.result-card {
  margin-top: 32rpx;
  padding: 24rpx;
  border-radius: 16rpx;
  background: #ffffff;
  border: 1rpx solid #f8bbd0;
  text-align: left;
}
.result-label { display: block; color: #bd548f; font-size: 24rpx; }
.result-value { display: block; margin-top: 10rpx; color: #2d1b2e; font-size: 28rpx; }
