.page {
  min-height: 100vh;
  background: #f5f5f7;
  box-sizing: border-box;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
}

.header {
  position: relative;
  height: 280rpx;
  background: linear-gradient(135deg, #e91e63, #ff5a8a);
  border-radius: 0 0 32rpx 32rpx;
  margin-bottom: -60rpx;
}

.header-bg {
  position: absolute;
  inset: 0;
  background: radial-gradient(circle at 80% 20%, rgba(255, 255, 255, 0.2), transparent 50%);
  border-radius: 0 0 32rpx 32rpx;
}

.user {
  position: absolute;
  left: 32rpx;
  right: 32rpx;
  bottom: 32rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  background: #ffffff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 60rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.5);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.1);
}

.avatar-image {
  display: block;
  object-fit: cover;
}

.user-info { flex: 1; color: #ffffff; }

.name {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
}

.level {
  display: block;
  font-size: 24rpx;
  opacity: 0.9;
}

.login-btn {
  background: rgba(255, 255, 255, 0.2);
  border: 2rpx solid rgba(255, 255, 255, 0.5);
  border-radius: 6rpx;
  color: #ffffff;
  font-size: 24rpx;
  height: 60rpx;
  line-height: 56rpx;
  margin: 0;
  padding: 0 18rpx;
}

.login-btn::after {
  border: 0;
}

/* 订单卡片 */
.order-card {
  position: relative;
  z-index: 2;
  margin: 0 24rpx 20rpx;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.order-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.order-title {
  color: #2d1b2e;
  font-size: 30rpx;
  font-weight: 700;
}

.order-all {
  color: #999;
  font-size: 24rpx;
}

.order-grid {
  display: flex;
}

.order-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  color: #2d1b2e;
  font-size: 24rpx;
}

.order-icon {
  width: 80rpx;
  height: 80rpx;
  background: linear-gradient(135deg, #fce4ec, #f8bbd0);
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
}

/* 菜单 */
.menu-card {
  margin: 0 24rpx;
  background: #ffffff;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.menu-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx 28rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.menu-item:last-child { border-bottom: 0; }

.menu-icon {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
}

.menu-name {
  flex: 1;
  color: #2d1b2e;
  font-size: 28rpx;
}

.menu-arrow {
  color: #ccc;
  font-size: 32rpx;
}
