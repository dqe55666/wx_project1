<view class="page" wx:if="{{order}}">
  <view class="hero green">
    <text class="h-title">{{order.isPaid ? '订单已支付' : '下单成功'}}</text>
    <text class="h-sub">{{order.isPaid ? '商品将尽快为您配送' : '请尽快完成支付'}}</text>
  </view>

  <view class="card">
    <view class="row"><text class="k">订单号</text><text class="v" style="font-family: monospace;">{{order.order_no}}</text></view>
    <view class="row"><text class="k">下单时间</text><text class="v">{{order.createdAt}}</text></view>
    <view class="row"><text class="k" style="font-weight:600; color:#2d1b2e;">应付金额</text>
      <text class="v" style="color:#e91e63; font-weight:700; font-size:32rpx;">¥{{order.amount}}</text>
    </view>
  </view>

  <view class="card">
    <text class="c-title">商品清单</text>
    <view class="list-item">
      <view class="li-main">
        <text class="li-title">{{order.product_name}}</text>
        <text class="li-sub">¥{{order.unitPrice}}  ×{{order.quantity}}</text>
      </view>
      <text class="v" style="color:#e91e63;">¥{{order.amount}}</text>
    </view>
  </view>

  <view wx:if="{{!order.isPaid}}" class="action" bindtap="goPay">立即支付</view>
  <view class="tip">{{order.isPaid ? '已完成支付' : '订单 30 分钟内未支付将自动取消'}}</view>
</view>
<view wx:elif="{{!loading}}" class="empty">订单不存在或已失效</view>
