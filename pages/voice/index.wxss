.page {
  min-height: 100vh;
  background: #f7f7fa;
  padding: 40rpx 32rpx calc(60rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.hero {
  background: linear-gradient(160deg, #ff5f9e, #ff4d8d 60%, #ff74ab);
  border-radius: 32rpx;
  padding: 56rpx 40rpx;
  text-align: center;
  color: #ffffff;
  margin-bottom: 48rpx;
  box-shadow: 0 14rpx 30rpx rgba(255, 77, 141, 0.28);
}

.hero .icon {
  font-size: 84rpx;
  display: block;
  margin-bottom: 16rpx;
}

.hero .title {
  display: block;
  font-size: 46rpx;
  font-weight: 800;
  margin-bottom: 10rpx;
}

.hero .subtitle {
  display: block;
  font-size: 30rpx;
  opacity: 0.95;
}

/* 大录音按钮（适老：易点、状态明显） */
.record-button {
  margin: 0 auto;
  width: 340rpx;
  height: 340rpx;
  border-radius: 50%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  background: linear-gradient(150deg, #ff5f9e, #ff4d8d);
  color: #ffffff;
  font-size: 34rpx;
  font-weight: 800;
  box-shadow: 0 18rpx 40rpx rgba(255, 77, 141, 0.34);
  transition: transform 0.12s ease;
}

.record-button::after { border: 0; }

.record-button .record-icon {
  font-size: 96rpx;
  line-height: 1;
}

.record-button.recording {
  background: linear-gradient(150deg, #ff5252, #e53935);
  box-shadow: 0 18rpx 40rpx rgba(229, 57, 53, 0.34);
  animation: pulse 1.2s ease-in-out infinite;
}

.record-hover {
  transform: scale(0.96);
  filter: brightness(0.93);
  box-shadow: inset 0 10rpx 22rpx rgba(150, 25, 80, 0.2);
}

.status {
  display: block;
  text-align: center;
  color: #7e7689;
  font-size: 30rpx;
  margin: 36rpx 0 8rpx;
  font-weight: 600;
}

.result-card {
  background: #ffffff;
  border: 2rpx solid #f1eaf5;
  border-radius: 28rpx;
  padding: 30rpx;
  margin-top: 24rpx;
  box-shadow: 0 6rpx 18rpx rgba(255, 77, 141, 0.06);
}

.result-label {
  display: block;
  color: #7e7689;
  font-size: 30rpx;
  margin-bottom: 12rpx;
}

.result-value {
  display: block;
  color: #23202a;
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.5;
}

/* 引导卡（无录音结果时） */
.hint-card {
  margin-top: 32rpx;
  background: #ffffff;
  border: 2rpx dashed #f0dbe6;
  border-radius: 28rpx;
  padding: 48rpx 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.hint-ic {
  font-size: 64rpx;
  line-height: 1;
  opacity: 0.6;
}

.hint-title {
  margin-top: 20rpx;
  font-size: 32rpx;
  font-weight: 800;
  color: #23202a;
}

.hint-sub {
  margin-top: 12rpx;
  font-size: 28rpx;
  color: #7e7689;
  line-height: 1.6;
}

@keyframes pulse {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.05); }
}
