.page {
  min-height: 100vh;
  background: #f7f7fa;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

/* 快捷条 */
.quickbar {
  display: flex;
  background: #ffffff;
  padding: 30rpx 24rpx;
  gap: 20rpx;
}

.quick-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 14rpx;
}

.quick-icon {
  width: 108rpx;
  height: 108rpx;
  border-radius: 34rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 46rpx;
}

.icon-pink {
  background: linear-gradient(145deg, #ff5f9e, #ff4d8d);
  box-shadow: 0 10rpx 22rpx rgba(255, 77, 141, 0.3);
}

.icon-soft {
  background: linear-gradient(145deg, #fff0f6, #ffd9e8);
}

.quick-item text {
  font-size: 30rpx;
  color: #23202a;
  font-weight: 700;
}

/* 列表 */
.list {
  padding: 24rpx 28rpx 0;
}

.item {
  display: flex;
  align-items: center;
  gap: 24rpx;
  background: #ffffff;
  border: 2rpx solid #f1eaf5;
  border-radius: 28rpx;
  padding: 28rpx 30rpx;
  margin-bottom: 22rpx;
  box-shadow: 0 6rpx 18rpx rgba(255, 77, 141, 0.06);
}

.avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 30rpx;
  flex: none;
  background: linear-gradient(145deg, #fff0f6, #ffd9e8);
  border: 2rpx solid #f1eaf5;
  box-sizing: border-box;
  color: #ff4d8d;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 42rpx;
  font-weight: 800;
}

.meta { flex: 1; min-width: 0; }

.line1 {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.name {
  color: #23202a;
  font-size: 33rpx;
  font-weight: 800;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.time {
  color: #7e7689;
  font-size: 28rpx;
  flex: none;
}

.line2 {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin-top: 10rpx;
}

.desc {
  color: #7e7689;
  font-size: 30rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.badge {
  flex: none;
  min-width: 44rpx;
  height: 40rpx;
  padding: 0 10rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #ff5f9e, #ff4d8d);
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 800;
  line-height: 40rpx;
  text-align: center;
}

/* 加载骨架 */
.skeleton {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
}

.sk-item {
  display: flex;
  align-items: center;
  gap: 24rpx;
  background: #ffffff;
  border: 2rpx solid #f1eaf5;
  border-radius: 28rpx;
  padding: 28rpx 30rpx;
}

.sk-avatar {
  flex: none;
  width: 100rpx;
  height: 100rpx;
  border-radius: 30rpx;
  background: #f0eaf5;
}

.sk-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.sk-line {
  height: 26rpx;
  border-radius: 13rpx;
  background: linear-gradient(90deg, #f0eaf5 25%, #f8f4fb 37%, #f0eaf5 63%);
  background-size: 400% 100%;
  animation: skShine 1.4s ease-in-out infinite;
}

.sk-w55 { width: 55%; }
.sk-w80 { width: 80%; }

@keyframes skShine {
  0% { background-position: 100% 0; }
  100% { background-position: 0 0; }
}

/* 空态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 24rpx 60rpx;
}

.empty-ic {
  font-size: 96rpx;
  line-height: 1;
  opacity: 0.45;
}

.empty-title {
  margin-top: 24rpx;
  font-size: 34rpx;
  font-weight: 800;
  color: #23202a;
}

.empty-sub {
  margin-top: 14rpx;
  font-size: 28rpx;
  color: #7e7689;
  text-align: center;
  line-height: 1.6;
}

/* 交互反馈 */
.tap {
  transform: scale(0.96);
  filter: brightness(0.93);
  box-shadow: inset 0 8rpx 18rpx rgba(150, 25, 80, 0.16) !important;
}

/* 透明容器专用按下反馈：不加内阴影，否则会凭空显出方框 */
.tap-soft {
  transform: scale(0.94);
  filter: brightness(0.94);
}

.quick-item,
.item {
  transition: transform 0.12s ease, opacity 0.12s ease;
}
