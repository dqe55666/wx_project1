@import "/assets/common.wxss";

.tabs {
  display: flex;
  background: #ffffff;
  position: sticky;
  top: 0;
  z-index: 5;
  border-bottom: 1rpx solid #f0f0f0;
  margin: -24rpx -28rpx 16rpx;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  position: relative;
  color: #888;
  font-size: 24rpx;
}

.tab.active {
  color: #2b2430;
  font-weight: 700;
}

.tab-bar {
  position: absolute;
  left: 50%;
  bottom: 6rpx;
  transform: translateX(-50%);
  width: 40rpx;
  height: 4rpx;
  background: #ff4d8d;
  border-radius: 4rpx;
}

.goods-row {
  display: flex;
  gap: 16rpx;
  margin-top: 12rpx;
}

.goods-cover {
  width: 140rpx;
  height: 140rpx;
  background: linear-gradient(135deg, #fff0f6, #f1eaf5);
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 60rpx;
  flex-shrink: 0;
}

.goods-main { flex: 1; min-width: 0; display: flex; flex-direction: column; }
.goods-name { color: #2b2430; font-size: 26rpx; font-weight: 600; }
.goods-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: auto;
}
.goods-price { color: #ff4d8d; font-size: 26rpx; font-weight: 700; }
.goods-count { color: #999; font-size: 22rpx; }
.paid-note { color: #17803d; font-size: 24rpx; }
