page { height: 100vh; background: #f5f7f8; }
.scrollarea { height: 100vh; }
.page { min-height: 100vh; padding: 32rpx 28rpx calc(40rpx + env(safe-area-inset-bottom)); box-sizing: border-box; }
.heading { margin-bottom: 24rpx; }
.title { display: block; color: #15232d; font-size: 44rpx; font-weight: 700; line-height: 1.25; }
.subtitle { display: block; color: #64727d; font-size: 26rpx; line-height: 1.5; margin-top: 10rpx; }
.employee-panel, .order-card { background: #fff; border: 1rpx solid #dbe4ea; border-radius: 8rpx; }
.employee-panel { margin-bottom: 24rpx; padding: 22rpx 24rpx; }
.label { color: #64727d; display: block; font-size: 24rpx; margin-bottom: 10rpx; }
.employee-picker { align-items: center; display: flex; justify-content: space-between; min-height: 70rpx; }
.employee-name { color: #15232d; display: block; font-size: 32rpx; font-weight: 600; }
.employee-area { color: #64727d; display: block; font-size: 24rpx; margin-top: 4rpx; }
.picker-arrow { color: #0f766e; font-size: 26rpx; }
.tabs { border-bottom: 1rpx solid #dbe4ea; display: flex; margin-bottom: 20rpx; }
.tab { color: #64727d; flex: 1; font-size: 29rpx; padding: 18rpx 0; text-align: center; }
.tab.active { border-bottom: 4rpx solid #0f766e; color: #0f766e; font-weight: 600; }
.order-card { margin-bottom: 18rpx; padding: 22rpx 24rpx; }
.order-top, .order-footer { align-items: center; display: flex; justify-content: space-between; }
.order-no { color: #64727d; font-size: 23rpx; }
.order-status { border-radius: 4rpx; font-size: 22rpx; padding: 5rpx 10rpx; }
.order-status.pending { background: #fff4d6; color: #9a6700; }
.order-status.accepted { background: #e7f5f2; color: #0f766e; }
.service-name { color: #15232d; font-size: 32rpx; font-weight: 600; margin: 16rpx 0 12rpx; }
.order-detail, .note { color: #52616f; font-size: 25rpx; line-height: 1.55; }
.note { background: #f5f7f8; margin-top: 12rpx; padding: 10rpx 12rpx; }
.order-footer { border-top: 1rpx solid #edf2f5; margin-top: 16rpx; padding-top: 16rpx; }
.distance, .accepted-by { color: #64727d; font-size: 24rpx; }
.accepted-by { color: #0f766e; }
.accept-btn { background: #0f766e; border-radius: 6rpx; color: #fff; font-size: 26rpx; height: 64rpx; line-height: 64rpx; margin: 0; padding: 0 30rpx; }
.accept-btn::after { border: 0; }
.empty { color: #7b8790; font-size: 27rpx; padding: 80rpx 0; text-align: center; }
.muted { color: #7b8790; font-size: 27rpx; }
