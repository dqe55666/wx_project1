page {
  height: 100vh;
  background: #f7faf9;
}

.scrollarea {
  height: 100vh;
}

.page {
  min-height: 100vh;
  padding: 36rpx 28rpx calc(44rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.hero {
  background: linear-gradient(135deg, #ffffff 0%, #fce4ec 52%, #e0f2f1 100%);
  border: 1rpx solid #e8d9df;
  border-radius: 8rpx;
  margin-bottom: 28rpx;
  padding: 34rpx 30rpx;
}

.eyebrow {
  color: #00897b;
  display: block;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1.4;
  margin-bottom: 10rpx;
}

.title {
  color: #263238;
  display: block;
  font-size: 52rpx;
  font-weight: 700;
  line-height: 1.2;
}

.subtitle {
  color: #546e7a;
  display: block;
  font-size: 27rpx;
  line-height: 1.55;
  margin-top: 12rpx;
}

.entry-grid {
  display: grid;
  gap: 18rpx;
}

.entry-card {
  align-items: center;
  background: #ffffff;
  border: 1rpx solid #e2e8e6;
  border-radius: 8rpx;
  display: flex;
  gap: 20rpx;
  min-height: 152rpx;
  padding: 24rpx;
}

.entry-card-active {
  opacity: 0.82;
}

.entry-mark {
  align-items: center;
  border-radius: 8rpx;
  color: #ffffff;
  display: flex;
  flex: none;
  font-size: 30rpx;
  font-weight: 700;
  height: 72rpx;
  justify-content: center;
  width: 72rpx;
}

.entry-content {
  flex: 1;
  min-width: 0;
}

.entry-title {
  color: #263238;
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.35;
}

.entry-desc {
  color: #607d8b;
  display: block;
  font-size: 24rpx;
  line-height: 1.45;
  margin-top: 8rpx;
}

.entry-arrow {
  color: #90a4ae;
  flex: none;
  font-size: 52rpx;
  line-height: 1;
}

.primary .entry-mark {
  background: #e91e63;
}

.mint .entry-mark {
  background: #00897b;
}

.sun .entry-mark {
  background: #f9a825;
}

.sea .entry-mark {
  background: #039be5;
}
