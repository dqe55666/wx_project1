<view class="page">
  <view class="hero">
    <text class="h-title">设置</text>
    <text class="h-sub">账号、安全、通知</text>
  </view>

  <view class="card">
    <view class="row" bindtap="togglePush">
      <text class="k">推送通知</text>
      <switch checked="{{push}}" color="#e91e63" />
    </view>
    <view class="row" bindtap="toggleFace">
      <text class="k">人脸登录</text>
      <switch checked="{{face}}" color="#e91e63" />
    </view>
  </view>

  <view class="card">
    <view class="row" bindtap="goAccount"><text class="k">账号信息</text><text class="li-arrow">›</text></view>
    <view class="row" bindtap="goChangePwd"><text class="k">修改密码</text><text class="li-arrow">›</text></view>
    <view class="row" bindtap="goPrivacy"><text class="k">隐私设置</text><text class="li-arrow">›</text></view>
    <view class="row" bindtap="goClearCache"><text class="k">清除缓存</text><text class="li-arrow">›</text></view>
  </view>

  <view class="card">
    <view class="row" bindtap="goAbout"><text class="k">关于我们</text><text class="li-arrow">›</text></view>
    <view class="row" bindtap="goCheckUpdate"><text class="k">检查更新</text><text class="v">v1.0.0</text></view>
  </view>

  <view class="action" bindtap="logout">退出登录</view>
</view>
