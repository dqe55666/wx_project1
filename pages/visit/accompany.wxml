<view class="page">
  <view class="hero orange">
    <text class="h-title">就医陪诊</text>
    <text class="h-sub">选择适合您的服务套餐</text>
  </view>

  <view class="card" wx:for="{{services}}" wx:key="id" bindtap="onSelect" data-name="{{item.name}}">
    <view class="row">
      <text class="k" style="color:#2d1b2e; font-weight:600;">{{item.name}}</text>
      <text class="v" style="color:#e91e63; font-weight:700;">¥{{item.price}} / {{item.unit}}</text>
    </view>
    <text class="c-desc">{{item.desc}}</text>
    <view class="tags" style="margin-top:16rpx;">
      <text class="tag">专业陪诊师</text>
      <text class="tag">24h 服务</text>
    </view>
  </view>
</view>
