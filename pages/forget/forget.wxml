<view class="page">
  <view class="logo-wrap">
    <view class="logo">
      <text class="logo-icon">♥</text>
    </view>
    <text class="page-title">忘记密码</text>
  </view>

  <view class="form">
    <view class="input-box">
      <text class="input-icon">📱</text>
      <input
        class="input"
        type="number"
        maxlength="11"
        placeholder="请输入手机号"
        placeholder-class="ph"
        value="{{phone}}"
        bindinput="onPhoneInput"
      />
    </view>

    <view class="input-box">
      <text class="input-icon">🔒</text>
      <input
        class="input"
        password="{{!showPassword}}"
        placeholder="设置新密码"
        placeholder-class="ph"
        value="{{password}}"
        bindinput="onPasswordInput"
      />
      <view class="eye" bindtap="togglePassword">
        <text wx:if="{{showPassword}}">👁</text>
        <text wx:else>👁‍🗨</text>
      </view>
    </view>

    <view class="input-box">
      <text class="input-icon">🔒</text>
      <input
        class="input"
        password="{{!showConfirm}}"
        placeholder="请确认新密码"
        placeholder-class="ph"
        value="{{confirmPassword}}"
        bindinput="onConfirmInput"
      />
      <view class="eye" bindtap="toggleConfirm">
        <text wx:if="{{showConfirm}}">👁</text>
        <text wx:else>👁‍🗨</text>
      </view>
    </view>
  </view>

  <button
    class="primary-btn"
    loading="{{submitting}}"
    disabled="{{submitting}}"
    bindtap="onSubmit"
  >确认</button>

  <view class="captcha-wrap">
    <captcha bind:success="onCaptchaSuccess" bind:fail="onCaptchaFail" />
  </view>
</view>
