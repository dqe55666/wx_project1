<view class="page">
  <view class="hero blue">
    <text class="h-title">陪诊时间</text>
    <text class="h-sub">选择合适的日期和时段</text>
  </view>

  <view class="card">
    <text class="c-title">选择日期</text>
    <view class="tags" style="gap:16rpx; margin-top:16rpx;">
      <view wx:for="{{dates}}" wx:key="*this"
            class="tag {{dateIdx === index ? 'solid' : ''}}"
            data-i="{{index}}" bindtap="pickDate">{{item}}</view>
    </view>
  </view>

  <view class="card">
    <text class="c-title">选择时段</text>
    <view class="tags" style="gap:16rpx; margin-top:16rpx;">
      <view wx:for="{{times}}" wx:key="*this"
            class="tag {{timeIdx === index ? 'solid' : ''}}"
            data-i="{{index}}" bindtap="pickTime">{{item}}</view>
    </view>
  </view>

  <view class="action" bindtap="confirm">确认时间</view>
</view>
