.page {
  min-height: 100vh;
  background: #f5f5f7;
  box-sizing: border-box;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
}

.searchbar {
  padding: 16rpx 24rpx;
  background: #ffffff;
}

.search-input {
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: #f5f5f7;
  border-radius: 32rpx;
  padding: 16rpx 24rpx;
  color: #999;
  font-size: 26rpx;
}

.search-icon { color: #999; }

.banners {
  white-space: nowrap;
  padding: 20rpx 24rpx;
  background: #ffffff;
}

.banner {
  display: inline-block;
  width: 640rpx;
  height: 220rpx;
  border-radius: 20rpx;
  margin-right: 20rpx;
  padding: 32rpx;
  color: #ffffff;
  vertical-align: top;
}

.banner-title {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
}

.banner-sub {
  display: block;
  font-size: 24rpx;
  opacity: 0.9;
}

.categories {
  display: flex;
  flex-wrap: wrap;
  background: #ffffff;
  padding: 24rpx 16rpx 16rpx;
  margin-top: 16rpx;
}

.cat-item {
  width: 25%;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  padding: 12rpx 0;
}

.cat-icon {
  width: 96rpx;
  height: 96rpx;
  background: linear-gradient(135deg, #fce4ec, #f8bbd0);
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
}

.cat-name {
  color: #2d1b2e;
  font-size: 24rpx;
}

.section {
  background: #ffffff;
  margin-top: 16rpx;
  padding: 24rpx 24rpx 8rpx;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.section-title {
  color: #2d1b2e;
  font-size: 30rpx;
  font-weight: 700;
}

.section-more {
  color: #999;
  font-size: 24rpx;
}

.goods {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.goods-item {
  width: calc((100% - 16rpx) / 2);
  background: #fafafa;
  border-radius: 16rpx;
  padding: 16rpx;
  box-sizing: border-box;
}

.goods-cover {
  width: 100%;
  height: 240rpx;
  background: linear-gradient(135deg, #fce4ec, #f8bbd0);
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 80rpx;
  margin-bottom: 12rpx;
}

.goods-name {
  display: block;
  color: #2d1b2e;
  font-size: 26rpx;
  line-height: 1.4;
  height: 72rpx;
  overflow: hidden;
}

.goods-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 8rpx;
}

.goods-price {
  color: #e91e63;
  font-size: 30rpx;
  font-weight: 700;
}

.goods-sales {
  color: #999;
  font-size: 22rpx;
}
