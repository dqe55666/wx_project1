<view class="page">
  <!-- 粉色头部 -->
  <view class="header" style="padding-top:{{statusBarHeight}}px;">
    <view class="topbar" style="padding-right:{{menuSafeRight}}px;">
      <view class="city" hover-class="tap-dim" hover-stay-time="80" bindtap="onCityTap">
        <text class="city-name">{{cityName}}</text>
        <view class="caret"></view>
      </view>
      <view class="searchbar">
        <text class="search-ic">🔍</text>
        <input
          class="search-input"
          value="{{keyword}}"
          bindinput="onKeywordInput"
          confirm-type="search"
          bindconfirm="onSearchTap"
          placeholder="搜索服务"
          placeholder-class="search-ph"
        />
        <view class="search-btn" hover-class="tap-dim" hover-stay-time="80" catchtap="onSearchTap">搜索</view>
      </view>
    </view>
  </view>

  <!-- 内容区 -->
  <view class="content">

    <!-- 服务卡片 -->
    <view class="services anim" style="animation-delay:0.02s;">
      <view class="svc svc-day" hover-class="tap" hover-stay-time="80" bindtap="goCreateVisit">
        <view class="svc-tag day">最低318元/次</view>
        <text class="svc-name day">全天陪诊</text>
        <text class="svc-sub">全程包接送</text>
        <view class="svc-go">立即体验</view>
        <text class="svc-wm">🚑</text>
      </view>
      <view class="svc-col">
        <view class="svc svc-vip" hover-class="tap" hover-stay-time="80" bindtap="goCreateVisit">
          <view class="svc-tag vip">最低338元/次</view>
          <view class="svc-line">
            <text class="svc-name vip">VIP陪诊</text>
            <text class="svc-mini vip">包接送</text>
          </view>
          <text class="svc-wm sm">👑</text>
        </view>
        <view class="svc svc-half" hover-class="tap" hover-stay-time="80" bindtap="goCreateVisit">
          <view class="svc-tag half">最低298元/次</view>
          <view class="svc-line">
            <text class="svc-name half">半天陪诊</text>
            <text class="svc-mini half">包接送</text>
          </view>
          <text class="svc-wm sm">💙</text>
        </view>
      </view>
    </view>

    <!-- 快捷入口 -->
    <view class="quick anim" style="animation-delay:0.08s;">
      <view class="quick-item" hover-class="tap" hover-stay-time="80" bindtap="goCreateVisit">
        <view class="quick-ic q-order"><text class="qi-emoji">💉</text></view>
        <text class="qi-name">立即下单</text>
      </view>
      <view class="quick-item" hover-class="tap" hover-stay-time="80" bindtap="goPackage">
        <view class="quick-ic q-pkg"><text class="qi-emoji">🎁</text></view>
        <text class="qi-name">套餐</text>
      </view>
      <view class="quick-item" hover-class="tap" hover-stay-time="80" bindtap="goMall">
        <view class="quick-ic q-mall"><text class="qi-emoji">🛍️</text></view>
        <text class="qi-name">商城</text>
      </view>
      <view class="quick-item" hover-class="tap" hover-stay-time="80" bindtap="goBottle">
        <view class="quick-ic q-bottle"><text class="qi-emoji">🍾</text></view>
        <text class="qi-name">漂流瓶</text>
      </view>
    </view>

    <!-- 本期优秀陪护师 -->
    <view class="section anim" style="animation-delay:0.14s;">
      <view class="sec-head">
        <view class="sec-title"><text class="sec-ic">💗</text>本期优秀陪护师</view>
        <text class="sec-more" hover-class="tap-dim" hover-stay-time="80" bindtap="goNurses">查看更多 ›</text>
      </view>
      <view class="nurses">
        <view class="nurse" wx:for="{{nurses}}" wx:key="id" hover-class="tap-soft" hover-stay-time="80" bindtap="goNurses">
          <view class="avatar">
            <image class="avatar-img" src="{{item.avatar}}" mode="widthFix" />
          </view>
          <text class="nurse-name">{{item.name}}</text>
        </view>
      </view>
    </view>

    <!-- 服务医院 -->
    <view class="section anim" style="animation-delay:0.2s;">
      <view class="sec-head">
        <view class="sec-title"><text class="sec-ic">❤️</text>服务医院</view>
        <text class="sec-more" hover-class="tap-dim" hover-stay-time="80" bindtap="openOrdersPage">我的预约 ›</text>
      </view>
      <view wx:if="{{hospitals.length}}" class="hosp-list">
        <view class="hosp" wx:for="{{hospitals}}" wx:key="id" hover-class="tap" hover-stay-time="80" bindtap="onHospitalTap" data-index="{{index}}">
          <view class="hosp-ic">🏥</view>
          <view class="hosp-main">
            <text class="hosp-name">{{item.name}}</text>
            <text class="hosp-addr">{{item.address}}</text>
          </view>
          <text class="hosp-dist">{{item.displayDistance}}</text>
        </view>
      </view>

      <!-- 加载中：骨架屏 -->
      <view wx:elif="{{hospitalLoading}}" class="hosp-skeleton">
        <view class="sk-row" wx:for="{{[1,2,3]}}" wx:key="*this">
          <view class="sk-ic"></view>
          <view class="sk-main">
            <view class="sk-line sk-w70"></view>
            <view class="sk-line sk-w45"></view>
          </view>
        </view>
      </view>

      <!-- 空态 -->
      <view wx:else class="empty-state">
        <text class="empty-ic">🏥</text>
        <text class="empty-title">附近暂无合作医院</text>
        <text class="empty-sub">可以重新定位试试，或先下单由陪护师协助安排</text>
        <view class="empty-btn" hover-class="tap-dim" hover-stay-time="80" bindtap="refreshLocation">重新定位</view>
      </view>
    </view>

  </view>
</view>
