page {
  background: #fff5f8;
  color: #2d1b2e;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
}

view, text, input, textarea, button, picker {
  box-sizing: border-box;
}

/* 全局字体优化 */
text {
  font-smooth: antialiased;
  -webkit-font-smoothing: antialiased;
}

/* 去除按钮默认阴影 */
button::after {
  border: 0 !important;
}

/* 统一主题色变量（供组件使用）*/
page {
  --color-primary: #e91e63;
  --color-primary-light: #f48fb1;
  --color-primary-soft: #fce4ec;
  --color-primary-bg: #f8bbd0;
  --color-text: #2d1b2e;
  --color-text-sub: #bd548f;
  --color-text-mute: #c9a8b5;
  --color-border: #f8bbd0;
  --color-bg: #fff5f8;
}