.page {
  min-height: 100vh;
  background: #f7f7fa;
  padding-bottom: calc(60rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

/* 头部渐变 */
.header {
  position: relative;
  padding: 0 32rpx 40rpx;
}

.header-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: -60rpx;
  background: linear-gradient(160deg, #ff5f9e, #ff4d8d 55%, #ff74ab);
  border-radius: 0 0 40rpx 40rpx;
}

.user {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding-top: 44rpx;
}

.avatar {
  width: 128rpx;
  height: 128rpx;
  border-radius: 36rpx;
  flex: none;
  background: linear-gradient(145deg, rgba(255, 255, 255, 0.34), rgba(255, 255, 255, 0.18));
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 60rpx;
  border: 3rpx solid rgba(255, 255, 255, 0.5);
  box-sizing: border-box;
  overflow: hidden;
}

.avatar-image { object-fit: cover; }

.user-info { flex: 1; min-width: 0; }

.name {
  display: block;
  color: #ffffff;
  font-size: 38rpx;
  font-weight: 800;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.level {
  display: block;
  color: rgba(255, 255, 255, 0.9);
  font-size: 30rpx;
  margin-top: 10rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.login-btn {
  flex: none;
  margin: 0;
  padding: 0 34rpx;
  height: 88rpx;
  line-height: 88rpx;
  background: #ffffff;
  color: #ff4d8d;
  font-size: 30rpx;
  font-weight: 800;
  border-radius: 44rpx;
  box-shadow: 0 8rpx 18rpx rgba(190, 30, 90, 0.2);
}

.login-btn::after { border: 0; }

/* 订单卡片 */
.order-card {
  position: relative;
  z-index: 2;
  margin: 32rpx 32rpx 0;
  background: #ffffff;
  border-radius: 28rpx;
  padding: 30rpx 28rpx;
  box-shadow: 0 10rpx 26rpx rgba(40, 20, 60, 0.08);
}

.order-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.order-title { font-size: 34rpx; font-weight: 800; color: #23202a; }
.order-all {
  font-size: 30rpx;
  color: #ff4d8d;
  font-weight: 700;
  padding: 12rpx 0 12rpx 20rpx;
}

.order-grid { display: flex; }

.order-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  padding: 6rpx 0;
}

.order-icon { font-size: 54rpx; }

.order-item text {
  font-size: 28rpx;
  color: #23202a;
  font-weight: 600;
}

/* 菜单卡片 */
.menu-card {
  margin: 28rpx 32rpx 40rpx;
  background: #ffffff;
  border-radius: 28rpx;
  padding: 0 28rpx;
  box-shadow: 0 10rpx 26rpx rgba(40, 20, 60, 0.06);
}

.menu-item {
  display: flex;
  align-items: center;
  gap: 22rpx;
  padding: 30rpx 0;
  border-bottom: 1rpx solid #f4f0f7;
}

.menu-item:last-child { border-bottom: 0; }

.menu-icon {
  font-size: 42rpx;
  width: 52rpx;
  text-align: center;
}

.menu-name {
  flex: 1;
  color: #23202a;
  font-size: 32rpx;
  font-weight: 600;
}

.menu-arrow {
  color: #b0a8ba;
  font-size: 38rpx;
}

/* 交互反馈 */
.tap {
  transform: scale(0.96);
  filter: brightness(0.93);
  box-shadow: inset 0 8rpx 18rpx rgba(150, 25, 80, 0.16) !important;
}

.tap-dim {
  opacity: 0.55;
}

/* 透明容器专用按下反馈：不加内阴影，否则会凭空显出方框 */
.tap-soft {
  transform: scale(0.94);
  filter: brightness(0.94);
}

.login-btn,
.order-all,
.order-item,
.menu-item {
  transition: transform 0.12s ease, opacity 0.12s ease;
}
