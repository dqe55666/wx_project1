<view class="page">
  <view class="skip" bindtap="skip">跳过</view>

  <swiper class="swiper" current="{{current}}" bindchange="onSwiperChange" indicator-dots="{{false}}">
    <swiper-item>
      <view class="slide">
        <view class="illu illu-1">🏥</view>
        <text class="title">专业陪诊</text>
        <text class="desc">专业陪诊师全程陪同，挂号、取药、问诊不迷茫</text>
      </view>
    </swiper-item>
    <swiper-item>
      <view class="slide">
        <view class="illu illu-2">💊</view>
        <text class="title">护理商城</text>
        <text class="desc">家用医疗、康复器械一站式购齐</text>
      </view>
    </swiper-item>
    <swiper-item>
      <view class="slide">
        <view class="illu illu-3">💬</view>
        <text class="title">实时沟通</text>
        <text class="desc">陪护师在线答疑，服务进度随时掌握</text>
        <view class="enter-btn" bindtap="goLogin">立即体验</view>
      </view>
    </swiper-item>
  </swiper>

  <view class="dots">
    <view class="dot {{current === 0 ? 'active' : ''}}"></view>
    <view class="dot {{current === 1 ? 'active' : ''}}"></view>
    <view class="dot {{current === 2 ? 'active' : ''}}"></view>
  </view>
</view>
