.page {
  min-height: 100vh;
  background: #f5f5f7;
  box-sizing: border-box;
}

.quickbar {
  display: flex;
  background: #ffffff;
  padding: 24rpx 16rpx;
  margin-bottom: 16rpx;
}

.quick-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  color: #2d1b2e;
  font-size: 24rpx;
}

.quick-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
}

.icon-pink {
  background: linear-gradient(135deg, #ff5a8a, #e91e63);
  color: #ffffff;
}

.icon-soft {
  background: #fce4ec;
  color: #e91e63;
}

.list {
  background: #ffffff;
  border-radius: 20rpx 20rpx 0 0;
  overflow: hidden;
}

.item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx 28rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.avatar {
  width: 88rpx;
  height: 88rpx;
  background: #fce4ec;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  flex-shrink: 0;
}

.meta { flex: 1; min-width: 0; }

.line1 {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.name {
  color: #2d1b2e;
  font-size: 28rpx;
  font-weight: 600;
}

.time {
  color: #999;
  font-size: 22rpx;
}

.line2 {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.desc {
  color: #888;
  font-size: 24rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  flex: 1;
}

.badge {
  min-width: 32rpx;
  height: 32rpx;
  padding: 0 8rpx;
  background: #ff4d4f;
  color: #ffffff;
  border-radius: 16rpx;
  font-size: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.empty {
  text-align: center;
  color: #999;
  padding: 80rpx 0;
  font-size: 26rpx;
}
