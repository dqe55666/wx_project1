<view class="page">
  <view class="hero">
    <view class="avatar">👩‍⚕️</view>
    <text class="h-title">{{name}}</text>
    <text class="h-sub">{{level}}  ·  ⭐ {{score}}  ·  服务 {{orders}} 次</text>
  </view>

  <view class="card">
    <text class="c-title">个人简介</text>
    <text class="c-desc">{{intro}}</text>
  </view>

  <view class="card">
    <text class="c-title">擅长医院</text>
    <view class="tags" style="margin-top:16rpx;">
      <text class="tag">张家界市人民医院</text>
      <text class="tag">张家界市中医院</text>
      <text class="tag">湘雅二医院</text>
    </view>
  </view>

  <view class="card">
    <text class="c-title">用户评价</text>
    <text class="c-desc">"非常专业，态度很好，强烈推荐！" —— 李先生</text>
    <text class="c-desc" style="margin-top:12rpx;">"全程陪同，省心省力。" —— 王女士</text>
  </view>
</view>
