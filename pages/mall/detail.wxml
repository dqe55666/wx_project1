<view class="page" wx:if="{{product}}">
  <view class="cover">{{product.cover}}</view>

  <view class="info">
    <view class="row">
      <text class="price">¥{{product.price}}</text>
      <text class="sales">已售 {{product.sales}}</text>
    </view>
    <text class="g-name">{{product.name}}</text>
    <text class="g-desc">{{product.description || '该商品暂无详细描述。'}}</text>
  </view>

  <view class="card">
    <view class="row">
      <text class="k">分类</text>
      <text class="v">{{product.category || '未分类'}}</text>
    </view>
    <view class="row">
      <text class="k">库存</text>
      <text class="v {{product.soldOut ? 'out-stock' : ''}}">{{product.stockText}}</text>
    </view>
  </view>

  <view class="card">
    <text class="c-title">商品详情</text>
    <text class="c-desc">商品分类：{{product.category || '未分类'}}。</text>
    <text class="c-desc" style="margin-top:12rpx;">库存和售价以当前商城展示为准。</text>
  </view>

  <view style="height: 200rpx;"></view>

  <view class="footer">
    <view class="action secondary {{product.soldOut ? 'disabled' : ''}}" bindtap="addToCart">{{product.soldOut ? '暂时缺货' : '加入购物车'}}</view>
    <view class="action {{product.soldOut ? 'disabled' : ''}}" bindtap="goCart">{{product.soldOut ? '暂时缺货' : '立即购买'}}</view>
  </view>
</view>
<view wx:elif="{{!loading}}" class="empty">商品已下架或不存在</view>
