<view class="page">
  <view class="hero purple">
    <text class="h-title">聊天设置</text>
    <text class="h-sub">管理消息、免打扰等</text>
  </view>

  <view class="card">
    <view class="row" bindtap="toggleMute">
      <text class="k">消息免打扰</text>
      <switch checked="{{mute}}" color="#e91e63" />
    </view>
    <view class="row" bindtap="toggleTop">
      <text class="k">会话置顶</text>
      <switch checked="{{top}}" color="#e91e63" />
    </view>
  </view>

  <view class="card">
    <view class="row" bindtap="clear"><text class="k">清空聊天记录</text><text class="li-arrow">›</text></view>
    <view class="row" bindtap="report"><text class="k">投诉陪护师</text><text class="li-arrow">›</text></view>
  </view>
</view>
