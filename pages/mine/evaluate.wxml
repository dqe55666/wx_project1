<view class="page">
  <view class="hero">
    <text class="h-title">商品评价</text>
    <text class="h-sub">您的反馈是我们改进的动力</text>
  </view>

  <view class="card">
    <view class="list-item">
      <view class="li-avatar">🛏️</view>
      <view class="li-main">
        <text class="li-title">医用护理床</text>
        <text class="li-sub">标准款 / 单摇</text>
      </view>
    </view>
  </view>

  <view class="card">
    <text class="c-title">商品评分</text>
    <view class="stars">
      <view wx:for="{{[1,2,3,4,5]}}" wx:key="*this"
            class="star {{rating >= item ? 'active' : ''}}"
            data-r="{{item}}" bindtap="setRating">★</view>
    </view>
  </view>

  <view class="card">
    <text class="c-title">评价内容</text>
    <textarea class="textarea" placeholder="请分享您对商品的使用感受" value="{{content}}" bindinput="onInput"></textarea>
  </view>

  <view class="action" bindtap="submit">提交评价</view>
</view>
