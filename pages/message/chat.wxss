.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #f5f5f7;
}

.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 28rpx;
  background: #ffffff;
  border-bottom: 1rpx solid #f0f0f0;
}

.t-name {
  color: #2d1b2e;
  font-size: 30rpx;
  font-weight: 700;
}

.t-actions {
  display: flex;
  gap: 20rpx;
  color: #2d1b2e;
  font-size: 32rpx;
}

.msg-list {
  flex: 1;
  padding: 20rpx 24rpx;
  box-sizing: border-box;
}

.msg {
  display: flex;
  flex-direction: column;
  margin-bottom: 24rpx;
}

.msg.me { align-items: flex-end; }
.msg.other { align-items: flex-start; }

.bubble {
  max-width: 70%;
  padding: 20rpx 24rpx;
  border-radius: 20rpx;
  font-size: 28rpx;
  line-height: 1.5;
  word-break: break-all;
}

.msg.me .bubble {
  background: linear-gradient(135deg, #ff5a8a, #e91e63);
  color: #ffffff;
  border-bottom-right-radius: 4rpx;
}

.msg.other .bubble {
  background: #ffffff;
  color: #2d1b2e;
  border-bottom-left-radius: 4rpx;
}

.msg-time {
  color: #999;
  font-size: 22rpx;
  margin-top: 6rpx;
}

.composer {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 20rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  border-top: 1rpx solid #f0f0f0;
}

.composer-input {
  flex: 1;
  background: #f5f5f7;
  border-radius: 32rpx;
  padding: 16rpx 24rpx;
  font-size: 28rpx;
  color: #2d1b2e;
  min-height: 44rpx;
}

.send-btn {
  padding: 16rpx 28rpx;
  background: #fce4ec;
  color: #bd548f;
  border-radius: 32rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.send-btn.active {
  background: linear-gradient(135deg, #ff5a8a, #e91e63);
  color: #ffffff;
}
