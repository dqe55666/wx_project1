page {
  height: 100vh;
  background: #f7faf9;
}

.scrollarea {
  height: 100vh;
}

.page {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 34rpx 28rpx calc(44rpx + env(safe-area-inset-bottom));
}

.heading {
  margin-bottom: 24rpx;
}

.title {
  color: #263238;
  display: block;
  font-size: 46rpx;
  font-weight: 700;
  line-height: 1.25;
}

.subtitle {
  color: #607d8b;
  display: block;
  font-size: 26rpx;
  line-height: 1.5;
  margin-top: 10rpx;
}

.summary {
  align-items: center;
  background: #ffffff;
  border: 1rpx solid #d8ebe8;
  border-radius: 8rpx;
  display: flex;
  justify-content: space-between;
  margin-bottom: 22rpx;
  padding: 28rpx;
}

.summary-label {
  color: #546e7a;
  font-size: 27rpx;
}

.summary-count {
  color: #00897b;
  font-size: 58rpx;
  font-weight: 700;
  line-height: 1;
}

.action-list {
  display: grid;
  gap: 16rpx;
}

.action-item {
  align-items: center;
  background: #ffffff;
  border: 1rpx solid #e2e8e6;
  border-radius: 8rpx;
  display: flex;
  justify-content: space-between;
  min-height: 130rpx;
  padding: 24rpx;
}

.action-item-active {
  opacity: 0.82;
}

.action-title {
  color: #263238;
  display: block;
  font-size: 31rpx;
  font-weight: 700;
  line-height: 1.35;
}

.action-desc {
  color: #607d8b;
  display: block;
  font-size: 24rpx;
  line-height: 1.45;
  margin-top: 8rpx;
}

.action-arrow {
  color: #90a4ae;
  font-size: 50rpx;
  line-height: 1;
  margin-left: 18rpx;
}
